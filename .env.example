# =========================
# Ollama
# =========================
# Model *-cloud KHONG chay tren may ban - chung chi la manifest vai tram byte,
# daemon Ollama proxy ra ollama.com. Nen co hai cach chay, chon MOT.
#
# --- Cach A: DEV, dung daemon Ollama tren may nay -------------------------
OLLAMA_BASE_URL=http://localhost:11434
#     Ten model GIU hau to -cloud (xem muc model o duoi):
#       LOCAL_OLLAMA_MODEL=gemma4:31b-cloud
#
# --- Cach B: PRODUCTION, khong cai gi, goi thang ollama.com ---------------
#     Bo comment 1 dong duoi, va comment dong OLLAMA_BASE_URL o tren:
# OLLAMA_BASE_URL=https://ollama.com/v1
#     Ten model BO hau to -cloud - day la buoc de quen nhat, quen se 404:
#       LOCAL_OLLAMA_MODEL=gemma4:31b
#       FAST_OLLAMA_MODEL=gpt-oss:120b
#       REASONING_OLLAMA_MODEL=gpt-oss:120b
#       CODING_OLLAMA_MODEL=gemma4:31b
#       FREE_OLLAMA_MODEL=gemma4:31b
#
# --- Cach C: khong dung Ollama -------------------------------------------
#     Dat DISABLED_PROVIDERS=ollama o muc ben duoi. Alias `local` se 503.
#
# Key lay tai https://ollama.com/settings/keys
#   - Cach A: khong bat buoc, nhung CO thi dashboard doc duoc usage
#     (session %, weekly %, so request tung model) tu ollama.com/api/usage
#   - Cach B: BAT BUOC, thieu se bao "ollama: API key not configured"
OLLAMA_API_KEY=

# =========================
# Free API keys
# =========================
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
ORCAROUTER_API_KEY=
ALIBABA_BASE_URL=
ALIBABA_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=

# =========================
# Gateway auth (optional)
# =========================
# Leave empty to accept any api_key (only safe when bound to localhost).
# If set, clients must send: Authorization: Bearer <this value>
GATEWAY_API_KEY=

# =========================
# Tat provider tren may khong co no
# =========================
# Danh sach ngan cach bang dau phay. Provider bi tat se bien mat khoi moi
# chuoi fallback, khoi /v1/models va khoi /quota.
# Vi du may production khong cai Ollama:
#   DISABLED_PROVIDERS=ollama
DISABLED_PROVIDERS=

# =========================
# Model per alias, per provider
# =========================
# Format: {ALIAS}_{PROVIDER}_MODEL
# Thu tu = thu tu fallback. Provider co qwen3.8-27b duoc uu tien;
# Ollama luon la chang cuoi. Defaults nam trong app/main.py.

# local -> ollama
LOCAL_OLLAMA_MODEL=gemma4:31b-cloud          # Cach B: gemma4:31b

# fast -> groq -> orcarouter -> cloudflare -> alibaba -> cerebras -> mistral -> openrouter -> ollama
FAST_GROQ_MODEL=qwen/qwen3.8-27b
FAST_ORCAROUTER_MODEL=qwen/qwen3.8-27b-free
FAST_CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
FAST_ALIBABA_MODEL=qwen3.8-27b
FAST_CEREBRAS_MODEL=gemma-4-31b
FAST_MISTRAL_MODEL=mistral-medium-latest
FAST_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
FAST_OLLAMA_MODEL=gpt-oss:120b-cloud          # Cach B: gpt-oss:120b

# reasoning -> groq -> orcarouter -> cloudflare -> alibaba -> cerebras -> mistral -> openrouter -> gemini -> ollama
REASONING_GROQ_MODEL=qwen/qwen3.8-27b
REASONING_ORCAROUTER_MODEL=qwen/qwen3.8-27b-free
REASONING_CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
REASONING_ALIBABA_MODEL=qwen3.8-27b
REASONING_CEREBRAS_MODEL=gemma-4-31b
REASONING_MISTRAL_MODEL=magistral-medium-latest
REASONING_OPENROUTER_MODEL=minimax/minimax-m3:free
REASONING_GEMINI_MODEL=gemini-3.5-flash
REASONING_OLLAMA_MODEL=gpt-oss:120b-cloud          # Cach B: gpt-oss:120b

# coding -> groq -> orcarouter -> alibaba -> mistral -> cloudflare -> cerebras -> ollama
CODING_GROQ_MODEL=qwen/qwen3.8-27b
CODING_ORCAROUTER_MODEL=qwen/qwen3.8-27b-free
CODING_ALIBABA_MODEL=qwen3.8-27b
CODING_MISTRAL_MODEL=codestral-latest
CODING_CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
CODING_CEREBRAS_MODEL=gemma-4-31b
CODING_OLLAMA_MODEL=gemma4:31b-cloud          # Cach B: gemma4:31b

# gemini -> gemini
GEMINI_GEMINI_MODEL=gemini-3.5-flash

# free -> orcarouter -> groq -> cloudflare -> alibaba -> cerebras -> mistral -> openrouter -> gemini -> ollama
FREE_ORCAROUTER_MODEL=qwen/qwen3.8-27b-free
FREE_GROQ_MODEL=qwen/qwen3.8-27b
FREE_CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
FREE_ALIBABA_MODEL=qwen3.8-27b
FREE_CEREBRAS_MODEL=gemma-4-31b
FREE_MISTRAL_MODEL=mistral-small-latest
FREE_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
FREE_GEMINI_MODEL=gemini-3.5-flash-lite
FREE_OLLAMA_MODEL=gemma4:31b-cloud          # Cach B: gemma4:31b
REQUEST_TIMEOUT=120
